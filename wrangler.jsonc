{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mexc-blue-heart-relay",
  "main": "./src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/admin.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mexc-blue-heart-relay",
      // Replace this placeholder with the ID of a newly created D1 database for remote deployment.
      "database_id": "eaa36e94-5fc5-4a4c-b149-16179367e370",
      "migrations_dir": "./migrations"
    }
  ]
}
